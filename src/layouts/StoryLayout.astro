---
import BaseLayout from './BaseLayout.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Pending from '../components/Pending.astro';
import UpdatedDate from '../components/UpdatedDate.astro';
import { SITE, sameAsList } from '../data/site';

interface Props {
  title: string;
  question: string;
  description: string;
  lead: string;
  publishDate: Date;
  updatedDate?: Date;
  related: { href: string; label: string; note?: string }[];
  slug: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  gallery?: {
    src: string;
    alt: string;
    width?: number;
    height?: number;
    caption?: string;
  }[];
}

const {
  title,
  question,
  description,
  lead,
  publishDate,
  updatedDate,
  related,
  slug,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  gallery,
} = Astro.props;

const published = publishDate.toISOString().slice(0, 10);
const updated = (updatedDate ?? publishDate).toISOString().slice(0, 10);
const url = new URL(`/stories/${slug}`, SITE.url).toString();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: 'ja',
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  url,
  datePublished: published,
  dateModified: updated,
  image: image ? new URL(image, SITE.url).toString() : undefined,
  author: {
    '@type': 'Person',
    name: SITE.personName,
    url: new URL('/profile', SITE.url).toString(),
    sameAs: sameAsList(),
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  about: {
    '@type': 'Person',
    name: SITE.personName,
  },
};
---

<BaseLayout
  title={title}
  description={description}
  updated={updated}
  ogType="article"
  jsonLd={articleSchema}
  showUpdated={false}
>
  <article class="mx-auto max-w-3xl px-5 py-12">
    <p class="text-sm text-sakura-deep">STORIES</p>
    <h1 class="mt-2 text-2xl leading-relaxed sm:text-3xl">{title}</h1>
    <p class="mt-3 text-sm text-ink-soft">この記事が答えている質問: {question}</p>
    <UpdatedDate date={updated} class="mt-1" />

    <p class="mt-8 border-l-4 border-sakura bg-white p-5 text-base leading-loose">
      <Pending text={lead} />
    </p>

    {
      image && imageAlt && (
        <PhotoSlot
          src={image}
          alt={imageAlt}
          width={imageWidth}
          height={imageHeight}
          class="mt-8"
        />
      )
    }

    <div class="prose-jp mt-10">
      <slot />
    </div>

    {
      gallery && gallery.length > 0 && (
        <section class="mt-14" aria-labelledby="gallery-heading">
          <h2 id="gallery-heading" class="text-lg">ツアー中の写真</h2>
          <div class="mt-4 grid gap-5 sm:grid-cols-2">
            {gallery.map((photo) => (
              <PhotoSlot
                src={photo.src}
                alt={photo.alt}
                width={photo.width}
                height={photo.height}
                caption={photo.caption}
                class="my-0"
              />
            ))}
          </div>
        </section>
      )
    }

    <RelatedLinks links={related} />
  </article>
</BaseLayout>
