---
/**
 * 未確定プレースホルダ（要確認マーカー）を含む文字列を表示する。
 * 未確定部分をハイライトするだけで、テキストはそのままHTMLに出力される。
 */
interface Props {
  text: string;
  class?: string;
}
const { text, class: className } = Astro.props;
const parts = String(text).split(/(\{\{要確認:[^}]*\}\})/g).filter((p) => p !== '');
---

<span class={className}>{
  parts.map((part) =>
    part.startsWith('{{要確認') ? <mark class="pending">{part}</mark> : <Fragment>{part}</Fragment>
  )
}</span>
