---
interface Props {
  links: { href: string; label: string; note?: string }[];
  heading?: string;
}
const { links, heading = '関連ページ' } = Astro.props;
---

<section class="mt-16 border-t border-line pt-8" aria-labelledby="related-heading">
  <h2 id="related-heading" class="text-lg">{heading}</h2>
  <ul class="mt-4 space-y-3">
    {
      links.map((link) => (
        <li>
          <a href={link.href} class="text-sakura-deep underline underline-offset-4">
            {link.label}
          </a>
          {link.note && <span class="block text-sm text-ink-soft">{link.note}</span>}
        </li>
      ))
    }
  </ul>
</section>
