---
import { NAV, SITE } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="border-b border-line bg-cream/95">
  <div class="mx-auto max-w-5xl px-5 py-4 flex items-center justify-between gap-4">
    <a href="/" class="font-serif text-lg tracking-wide">
      {SITE.personName}
      <span class="sr-only">オフィシャルサイト</span>
    </a>

    <nav aria-label="メインナビゲーション" class="hidden md:block">
      <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={path === item.href ? 'page' : undefined}
                class="hover:text-sakura-deep"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- スマホ用。JavaScriptなしで開閉する -->
    <details class="md:hidden relative">
      <summary class="cursor-pointer list-none text-sm border border-line px-3 py-1.5"
        >メニュー</summary
      >
      <nav
        aria-label="メインナビゲーション（モバイル）"
        class="absolute right-0 top-full z-10 mt-2 w-56 border border-line bg-cream p-4 shadow-sm"
      >
        <ul class="space-y-2 text-sm">
          {
            NAV.map((item) => (
              <li>
                <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
