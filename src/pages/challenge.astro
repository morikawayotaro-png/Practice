---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { PAGES } from '../data/pages';

const stories = (await getCollection('stories')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="今の挑戦"
  description={PAGES.challenge.description}
  updated={PAGES.challenge.updated}
>
  <div class="mx-auto max-w-3xl px-5 py-12">
    <h1 class="text-2xl sm:text-3xl">今の挑戦</h1>

    <p class="mt-6 border-l-4 border-sakura bg-white p-5 leading-loose">
横峯さくらが目指しているのは、JLPGAツアーの永久シード獲得。通算30勝を挙げた選手に与えられる生涯有効の出場資格で、これまでに獲得した女子選手は樋口久子さんら6人しかいない。横峯さくらの通算勝利数は23勝。あと7勝で到達する。2021年2月に出産したあとも家族とともにツアーを回りながら、この記録に挑み続けている。
    </p>

    <PhotoSlot
      src="/photos/challenge/reading-green.webp"
      alt="グリーンにしゃがみ込んでパットのラインを読む横峯さくら"
      width={1600}
      height={1068}
    />

    <PhotoSlot
      src="/photos/hero/on-course.webp"
      alt="EPSONのキャップをかぶり、クラブを手にボールの行方を見つめる横峯さくら"
      width={1638}
      height={1093}
    />

    <section class="mt-12" aria-labelledby="now-heading">
      <h2 id="now-heading" class="text-xl">永久シードの現在地はどこか</h2>
      <p class="mt-4 leading-loose">
通算23勝で、あと7勝。2004年のプロ転向から20年以上をかけて積み上げてきた数字で、現役選手では最も永久シードに近い位置のひとりにいる。
      </p>
    </section>

    <section class="mt-12" aria-labelledby="why-heading">
      <h2 id="why-heading" class="text-xl">なぜ今も挑戦を続けるのか</h2>
      <p class="mt-4 leading-loose">
米ツアー時代に、出産後もプレーする選手たちの姿から「競技を続ける」という選択肢を教わったから。今度は自分が挑戦する姿を見せることで、後輩の選手や同じ立場で迷っている人に選択肢を示したいと考えている。
      </p>
    </section>

    <section class="mt-12" aria-labelledby="plan-heading">
      <h2 id="plan-heading" class="text-xl">これから何に取り組むのか</h2>
      <p class="mt-4 leading-loose">
家族と車で移動するツアー生活を保ちながら、年間を通じてJLPGAツアーに出場を続ける。体力面と技術面の両方を整え、優勝争いに絡む回数を増やしていく。
      </p>
    </section>

    <section class="mt-12" aria-labelledby="stories-heading">
      <h2 id="stories-heading" class="text-xl">記録を読む</h2>
      <p class="mt-2 text-sm text-ink-soft">それぞれのテーマを1ページにまとめています。</p>
      <ul class="mt-6 space-y-5">
        {
          stories.map((story) => (
            <li class="border border-line bg-white p-6">
              <h3 class="text-lg leading-relaxed">
                <a href={`/stories/${story.id}`} class="hover:text-sakura-deep">
                  {story.data.title}
                </a>
              </h3>
              <p class="mt-2 text-sm text-ink-soft">{story.data.question}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <RelatedLinks
      links={[
        { href: '/profile', label: 'プロフィール', note: '経歴と戦績' },
        { href: '/sakura-baton', label: 'SAKURA BATON', note: '競技以外の取り組み' },
        { href: '/news', label: 'ニュース', note: '最新のお知らせ' },
      ]}
    />
  </div>
</BaseLayout>
