---
import BaseLayout from '../layouts/BaseLayout.astro';
import Pending from '../components/Pending.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { SPONSOR_GROUPS, SPECIAL_THANKS } from '../data/sponsors';
import { PAGES } from '../data/pages';
---

<BaseLayout
  title="スポンサー"
  description={PAGES.sponsors.description}
  updated={PAGES.sponsors.updated}
>
  <div class="mx-auto max-w-3xl px-5 py-12">
    <h1 class="text-2xl sm:text-3xl">スポンサー</h1>
    <p class="mt-4 leading-loose">
      横峯さくらの活動を支えていただいている企業・団体です。
    </p>

    {
      SPONSOR_GROUPS.map((group) => (
        <section class="mt-12" aria-labelledby={`sponsor-${group.id}`}>
          <h2 id={`sponsor-${group.id}`} class="text-xl">
            {group.heading}
          </h2>
          {group.note && <p class="mt-1 text-sm text-ink-soft">{group.note}</p>}
          {group.id === 'equipment' && (
            <div class="mt-4 grid items-start gap-4 sm:grid-cols-3">
              <PhotoSlot
                src="/photos/sponsors/golf-bag.webp"
                alt="コースでゴルフバッグからクラブを取り出す横峯さくら"
                width={1600}
                height={1068}
                class="my-0"
              />
              <PhotoSlot
                src="/photos/sponsors/club-factory.webp"
                alt="工房で仕上げ前のアイアンヘッドを手に取って確かめる横峯さくら"
                width={1600}
                height={1067}
                class="my-0"
              />
              <PhotoSlot
                src="/photos/sponsors/golf-shoe.webp"
                alt="ゴルフシューズを手に持つ横峯さくら"
                width={1600}
                height={2133}
                class="my-0"
              />
            </div>
          )}
          <ul class="mt-4 grid gap-4 sm:grid-cols-2">
            {group.sponsors.map((sponsor) => (
              <li class="flex items-center gap-4 border border-line bg-white p-4">
                {sponsor.logo ? (
                  <img
                    src={sponsor.logo}
                    alt={sponsor.name}
                    width={300}
                    height={120}
                    loading="lazy"
                    decoding="async"
                    class="h-12 w-auto shrink-0 object-contain"
                  />
                ) : (
                  <span
                    class="flex h-12 w-24 shrink-0 items-center justify-center border border-dashed border-line text-[10px] text-ink-soft"
                    role="img"
                    aria-label={sponsor.name}
                  >
                    ロゴ未入稿
                  </span>
                )}
                <span class="text-sm">
                  {sponsor.url ? (
                    <a href={sponsor.url} rel="noopener" target="_blank" class="underline">
                      <Pending text={sponsor.name} />
                    </a>
                  ) : (
                    <Pending text={sponsor.name} />
                  )}
                  {sponsor.category && (
                    <span class="block text-xs text-ink-soft">
                      <Pending text={sponsor.category} />
                    </span>
                  )}
                </span>
              </li>
            ))}
          </ul>
          {group.id === 'sponsors' && (
            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              <PhotoSlot
                src="/photos/sponsors/smeg-sparkling-water.webp"
                alt="キッチンでSMEGのスパークリングウォーターメーカーに手を添える横峯さくら"
                width={1320}
                height={1963}
                class="my-0"
              />
              <PhotoSlot
                src="/photos/sponsors/smeg-kettle.webp"
                alt="SMEGの電気ケトルを手に持つ横峯さくら"
                width={1320}
                height={1949}
                class="my-0"
              />
            </div>
          )}
        </section>
      ))
    }

    <section class="mt-12" aria-labelledby="special-thanks">
      <h2 id="special-thanks" class="text-xl">SPECIAL THANKS</h2>
      <ul class="mt-4 space-y-1 text-sm">
        {
          SPECIAL_THANKS.map((item) => (
            <li>
              {item.role}: <Pending text={item.name} />
            </li>
          ))
        }
      </ul>
    </section>

    <RelatedLinks
      links={[
        { href: '/partners', label: 'スポンサーシップ・出演のご案内', note: 'ご依頼の窓口' },
        { href: '/sakura-baton', label: 'SAKURA BATON', note: '社会貢献の取り組み' },
        { href: '/profile', label: 'プロフィール', note: '経歴と戦績' },
      ]}
    />
  </div>
</BaseLayout>
