---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import Pending from '../../components/Pending.astro';
import { PAGES } from '../../data/pages';

const news = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<BaseLayout title="ニュース" description={PAGES.news.description} updated={PAGES.news.updated}>
  <div class="mx-auto max-w-3xl px-5 py-12">
    <h1 class="text-2xl sm:text-3xl">ニュース</h1>
    <p class="mt-4 leading-loose">
      横峯さくらに関するお知らせ、大会の出場予定と結果、活動の報告を新しい順に掲載しています。
      各記事には公開日と、内容を更新した場合は更新日を表示しています。
      日付は西暦で表記し、「最近」「先日」といった表現は使いません。
      取材のご依頼は<a href="/partners" class="text-sakura-deep underline underline-offset-4">ご案内ページ</a>をご覧ください。
    </p>

    <div class="mt-8">
      {
        news.length > 0 ? (
          news.map((item) => (
            <NewsCard
              href={`/news/${item.id}`}
              title={item.data.title}
              description={item.data.description}
              date={item.data.publishDate}
              category={item.data.category}
            />
          ))
        ) : (
          <p class="py-6 text-sm text-ink-soft">まだ記事はありません。</p>
        )
      }
    </div>
  </div>
</BaseLayout>
