---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import UpdatedDate from '../../components/UpdatedDate.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { SITE, sameAsList } from '../../data/site';

export async function getStaticPaths() {
  const news = await getCollection('news', ({ data }) => !data.draft);
  return news.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const data = item.data;

const published = data.publishDate.toISOString().slice(0, 10);
const updated = (data.updatedDate ?? data.publishDate).toISOString().slice(0, 10);
const url = new URL(`/news/${item.id}`, SITE.url).toString();

const newsSchema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: data.title,
  description: data.description,
  inLanguage: 'ja',
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  datePublished: published,
  dateModified: updated,
  image: data.image ? new URL(data.image, SITE.url).toString() : undefined,
  author: {
    '@type': 'Person',
    name: SITE.personName,
    url: new URL('/profile', SITE.url).toString(),
    sameAs: sameAsList(),
  },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  updated={updated}
  ogType="article"
  ogImage={data.image}
  jsonLd={newsSchema}
  showUpdated={false}
>
  <article class="mx-auto max-w-3xl px-5 py-12">
    <p class="text-sm text-sakura-deep">{data.category}</p>
    <h1 class="mt-2 text-2xl leading-relaxed sm:text-3xl">{data.title}</h1>
    <UpdatedDate date={published} label="公開日" class="mt-3" />
    {data.updatedDate && <UpdatedDate date={updated} />}

    {
      data.image && (
        <img
          src={data.image}
          alt={data.imageAlt ?? data.title}
          loading="lazy"
          decoding="async"
          class="mt-8 w-full h-auto"
        />
      )
    }

    <div class="prose-jp mt-8">
      <Content />
    </div>

    <RelatedLinks
      links={[
        { href: '/news', label: 'ニュース一覧', note: 'すべてのお知らせ' },
        { href: '/challenge', label: '今の挑戦', note: '永久シードの現在地' },
        { href: '/profile', label: 'プロフィール', note: '経歴と戦績' },
      ]}
    />
  </article>
</BaseLayout>
