---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { PAGES } from '../data/pages';
import { SITE } from '../data/site';

const requests = [
  {
    title: 'スポンサーシップ',
    body: '横峯さくら個人へのスポンサードと、社会貢献プロジェクトSAKURA BATONへの協賛を受け付けています。ウェアやキャップへのロゴ掲出、広告出演、共同企画など、目的に合わせて内容を設計します。マネジメントはHERITAGE合同会社が担当しています。',
  },
  {
    title: 'イベント出演・レッスン',
    body: 'ゴルフコンペへのゲスト参加、企業イベント出演、レッスン会を受け付けています。開催日・場所・内容をお知らせください。ツアー日程と調整のうえ回答します。',
  },
  {
    title: '取材・メディア',
    body: 'テレビ・雑誌・WEB媒体の取材および出演依頼を受け付けています。企画内容、放送・掲載時期、拘束時間をあわせてお知らせください。',
  },
  {
    title: '講演',
    body: '競技と子育ての両立、ツアー生活、目標への向き合い方をテーマにした講演を受け付けています。聴講対象と人数、希望テーマをお知らせください。',
  },
];
---

<BaseLayout
  title="スポンサーシップ・出演のご案内"
  description={PAGES.partners.description}
  updated={PAGES.partners.updated}
>
  <div class="mx-auto max-w-3xl px-5 py-12">
    <h1 class="text-2xl sm:text-3xl">スポンサーシップ・出演のご案内</h1>

    <p class="mt-6 border-l-4 border-sakura bg-white p-5 leading-loose">
      横峯さくらへのスポンサーシップ、イベント出演、取材、講演のご依頼は、{SITE.contact.company}が窓口です。
      下記の内容をご確認のうえ、ご連絡ください。
    </p>

    <section class="mt-12" aria-labelledby="requests-heading">
      <h2 id="requests-heading" class="text-xl">どんな依頼を受け付けているか</h2>
      <dl class="mt-4 divide-y divide-line border-y border-line">
        {
          requests.map((item) => (
            <div class="py-4">
              <dt class="font-medium">{item.title}</dt>
              <dd class="mt-1 text-sm leading-loose">{item.body}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-12" aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="text-xl">依頼先はどこか</h2>
      <div class="mt-4 border border-line bg-white p-6">
        <p class="font-medium">{SITE.contact.company}</p>
        <p class="mt-2 text-sm">
          メール: <a href={`mailto:${SITE.contact.email}`} class="underline"
            >{SITE.contact.email}</a
          >
        </p>
        <p class="mt-1 text-sm">所在地: {SITE.contact.address}</p>
      </div>
      <p class="mt-4 text-sm leading-loose">
        ご連絡の際は、会社名・担当者名／依頼内容／希望日時と場所／予算感をお書きください。回答は{
          SITE.contact.replyTime
        }を目安にしています。
      </p>
    </section>

    <RelatedLinks
      links={[
        { href: '/sponsors', label: 'スポンサー', note: '現在ご支援いただいている企業' },
        { href: '/profile', label: 'プロフィール', note: '経歴と戦績' },
        { href: '/media', label: 'メディア出演・掲載', note: '過去の出演実績' },
      ]}
    />
  </div>
</BaseLayout>
