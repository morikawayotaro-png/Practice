---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { PAGES } from '../data/pages';

const pillars = [
  {
    name: '競技',
    body: '通算30勝の永久シードに挑み続けること自体が、このプロジェクトの土台になっている。子育てをしながら競技を続ける姿を見せることが、後輩の選手や同じ立場で迷っている人への何よりの発信になると考えている。',
  },
  {
    name: '発信',
    body: 'ツアーを回る暮らしや子育ての日々をInstagramなどで伝えている。飾らない日常を見せることで、「子どもがいても続けられる」という選択肢を届けることを心がけている。',
  },
  {
    name: '社会貢献',
    body: 'Sakura Birdie Fundによる寄付と、子どもたちのスポーツ環境への支援を行っている。',
  },
];
---

<BaseLayout
  title="SAKURA BATON"
  description={PAGES.sakuraBaton.description}
  updated={PAGES.sakuraBaton.updated}
>
  <div class="mx-auto max-w-3xl px-5 py-12">
    <h1 class="text-2xl sm:text-3xl">SAKURA BATON</h1>

    <p class="mt-6 border-l-4 border-sakura bg-white p-5 leading-loose">
      SAKURA BATONは、横峯さくらが2024年に始めた社会貢献プロジェクト。競技・発信・社会貢献という3つの活動を一本の糸でつなぎ、自分がゴルフから受け取ってきたものを次の世代に渡していくことを目的にしている。名前には「バトンを渡す」という意味を込めた。
    </p>

    <PhotoSlot
      src="/photos/sakura-baton/talking-to-children.webp"
      alt="フウガドールすみだの子どもたちに向かって話す横峯さくら"
      width={1600}
      height={1067}
      caption="2026年4月撮影。SAKURA BATONが支援するフウガドールすみだの選手たちと。"
    />

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <PhotoSlot
        src="/photos/sakura-baton/group-with-children.webp"
        alt="SAKURA BATONのロゴが入ったユニフォームを持つ指導者と、フウガドールすみだの子どもたちと並ぶ横峯さくら"
        width={1600}
        height={1067}
        class="my-0"
      />
      <PhotoSlot
        src="/photos/sakura-baton/fugador-sumida-jersey.webp"
        alt="SAKURA BATONのロゴが入った背番号4のフウガドールすみだのユニフォームを広げて持つ横峯さくら"
        width={1600}
        height={1200}
        class="my-0"
      />
    </div>

    <section class="mt-12" aria-labelledby="pillars-heading">
      <h2 id="pillars-heading" class="text-xl">3本柱とは何か</h2>
      <p class="mt-4 leading-loose">
        競技・発信・社会貢献の3つを、それぞれ別の活動としてではなく、ひとつながりのものとして進めている。競技を続けることが発信になり、発信が社会貢献につながる。この3つを一本の糸でつなぐことがSAKURA BATONの考え方になっている。
      </p>
      <div class="mt-6 space-y-6">
        {
          pillars.map((pillar, i) => (
            <div class="border border-line bg-white p-6">
              <p class="text-sm text-sakura-deep">0{i + 1}</p>
              <h3 class="mt-1 text-lg">{pillar.name}</h3>
              <p class="mt-2 leading-loose">{pillar.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-12" aria-labelledby="fund-heading">
      <h2 id="fund-heading" class="text-xl">Sakura Birdie Fund はどんな仕組みか</h2>
      <p class="mt-4 leading-loose">
        2024年に始めた取り組みで、横峯さくらがツアーでバーディを1つ奪うごとに1,000円、イーグルで1万円、ホールインワンで5万円を子ども支援団体に寄付する。
      </p>
      <p class="mt-4 leading-loose">
        寄付先は日本財団とクリステル・ヴィ・アンサンブルの2団体。プレーが良いほど支援が増える仕組みで、コースでの結果がそのまま子どもたちに届く。
      </p>
      <dl class="mt-6 divide-y divide-line border-y border-line text-sm">
        <div class="grid grid-cols-[9rem_1fr] gap-4 py-3">
          <dt class="text-ink-soft">バーディ</dt>
          <dd>1つにつき 1,000円</dd>
        </div>
        <div class="grid grid-cols-[9rem_1fr] gap-4 py-3">
          <dt class="text-ink-soft">イーグル</dt>
          <dd>1つにつき 1万円</dd>
        </div>
        <div class="grid grid-cols-[9rem_1fr] gap-4 py-3">
          <dt class="text-ink-soft">ホールインワン</dt>
          <dd>1回につき 5万円</dd>
        </div>
        <div class="grid grid-cols-[9rem_1fr] gap-4 py-3">
          <dt class="text-ink-soft">寄付先</dt>
          <dd>日本財団／クリステル・ヴィ・アンサンブル</dd>
        </div>
      </dl>
    </section>

    <section class="mt-12" aria-labelledby="fugador-heading">
      <h2 id="fugador-heading" class="text-xl">フウガドールすみだへの支援とは</h2>
      <p class="mt-4 leading-loose">
        フットサルクラブ「フウガドールすみだ」の育成組織を、ユニフォームの胸スポンサーとして支援している（2年契約）。
      </p>
      <p class="mt-4 leading-loose">
        2026年7月にはU-18チームが全日本U-18フットサル選手権で優勝し、日本一になった。
      </p>
    </section>

    <section class="mt-12" aria-labelledby="join-heading">
      <h2 id="join-heading" class="text-xl">支援や協業を考えている場合はどうすればよいか</h2>
      <p class="mt-4 leading-loose">
        ご相談はHERITAGE合同会社が窓口です。<a
          href="/partners"
          class="text-sakura-deep underline underline-offset-4">ご案内ページ</a
        >に連絡先をまとめています。
      </p>
    </section>

    <RelatedLinks
      links={[
        {
          href: '/stories/childcare-on-tour',
          label: 'ツアーに託児所を',
          note: '環境づくりの取り組み',
        },
        { href: '/challenge', label: '今の挑戦', note: '競技の現在地' },
        { href: '/partners', label: 'スポンサーシップ・出演のご案内', note: '協業のご相談' },
      ]}
    />
  </div>
</BaseLayout>
