---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { SITE, sameAsList } from '../data/site';
import { PAGES } from '../data/pages';
import {
  PROFILE_SUMMARY,
  BASIC_FACTS,
  ACTS,
  RESULTS,
  RESULTS_SUMMARY,
  MAJOR_RECORDS,
  CURRENT_GOAL,
} from '../data/profile';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.personName,
  alternateName: SITE.personNameEn,
  jobTitle: SITE.jobTitle,
  nationality: '日本',
  url: new URL('/profile', SITE.url).toString(),
  mainEntityOfPage: { '@type': 'WebPage', '@id': new URL('/profile', SITE.url).toString() },
  sameAs: sameAsList(),
  description: PROFILE_SUMMARY,
  birthDate: '1985-12-13',
  birthPlace: { '@type': 'Place', name: '鹿児島県鹿屋市' },
  height: { '@type': 'QuantitativeValue', value: 155, unitCode: 'CMT' },
  affiliation: { '@type': 'Organization', name: 'エプソン販売' },
  memberOf: { '@type': 'SportsOrganization', name: '日本女子プロゴルフ協会（JLPGA）' },
  award: MAJOR_RECORDS,
  knowsAbout: ['ゴルフ', 'JLPGAツアー', '女性アスリートの育児と競技の両立'],
};
---

<BaseLayout
  title="プロフィール"
  description={PAGES.profile.description}
  updated={PAGES.profile.updated}
  ogType="profile"
  jsonLd={personSchema}
>
  <div class="mx-auto max-w-3xl px-5 py-12">
    <h1 class="text-2xl sm:text-3xl">プロフィール</h1>

    <p class="mt-6 border-l-4 border-sakura bg-white p-5 leading-loose">{PROFILE_SUMMARY}</p>

    <PhotoSlot
      src="/photos/profile/portrait-smile.webp"
      alt="EPSONのキャップをかぶり笑顔を見せる横峯さくら"
      width={1600}
      height={2400}
      ratio="aspect-[4/5] sm:aspect-[3/2]"
      position="object-[center_25%]"
    />

    <section class="mt-12" aria-labelledby="basic-heading">
      <h2 id="basic-heading" class="text-xl">基本情報</h2>
      <dl class="mt-4 divide-y divide-line border-y border-line">
        {
          BASIC_FACTS.map((fact) => (
            <div class="grid grid-cols-[7rem_1fr] gap-4 py-3 text-sm sm:grid-cols-[9rem_1fr]">
              <dt class="text-ink-soft">{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-12" aria-labelledby="career-heading">
      <h2 id="career-heading" class="text-xl">経歴</h2>
      {
        ACTS.map((act) => (
          <div class="mt-8">
            <p class="text-sm text-sakura-deep">{act.act}</p>
            <h3 class="mt-1 text-lg">{act.heading}</h3>
            <p class="mt-1 text-sm text-ink-soft">{act.period}</p>
            <p class="mt-3 leading-loose">{act.body}</p>
          </div>
        ))
      }
    </section>

    <section class="mt-12" aria-labelledby="results-heading">
      <h2 id="results-heading" class="text-xl">戦績</h2>
      <p class="mt-2 text-sm text-ink-soft">{RESULTS_SUMMARY}</p>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="border-b border-line text-left">
              <th scope="col" class="py-2 pr-4">年</th>
              <th scope="col" class="py-2 pr-4">大会</th>
              <th scope="col" class="py-2">成績</th>
            </tr>
          </thead>
          <tbody>
            {
              RESULTS.map((row) => (
                <tr class="border-b border-line">
                  <td class="py-2 pr-4 align-top whitespace-nowrap">{row.year}</td>
                  <td class="py-2 pr-4 align-top">{row.tournament}</td>
                  <td class="py-2 align-top whitespace-nowrap">{row.result}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <h3 class="mt-8 text-lg">主要記録</h3>
      <ul class="mt-3 space-y-2 text-sm">
        {MAJOR_RECORDS.map((record) => <li>{record}</li>)}
      </ul>
    </section>

    <section class="mt-12" aria-labelledby="goal-heading">
      <h2 id="goal-heading" class="text-xl">現在の目標</h2>
      <p class="mt-4 leading-loose">{CURRENT_GOAL}</p>
    </section>

    <RelatedLinks
      links={[
        { href: '/challenge', label: '今の挑戦', note: '永久シードの現在地' },
        { href: '/stories/tour-life', label: '家族と旅するツアー暮らし', note: 'ツアー生活の実際' },
        { href: '/media', label: 'メディア出演・掲載', note: '出演と掲載の履歴' },
      ]}
    />
  </div>
</BaseLayout>
